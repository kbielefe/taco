USDA_API_KEY=
XAI_API_KEY=
# Reasoning effort on outgoing xAI calls: none, minimal, low, medium, high, xhigh, or max. Default low.
XAI_REASONING_EFFORT=low
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_CACHE_USERNAME=cache
MONGO_CACHE_PASSWORD=
MONGODB_URI=mongodb://cache:PASSWORD@127.0.0.1:27017/health?authSource=health
PORT=3001
HOST=127.0.0.1
CLOUDFLARE_TUNNEL_TOKEN=
# Google sign-in for the website. All three are required together. One allowed email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=
# Alexa skill client. All three are required together. The skill never uses the Google client.
# Console steps are in docs/voice.md. Google has no custom skill to configure.
# Redirect URIs to allow in the Alexa console are the pitangui, layla, and alexa.amazon.co.jp skill link URLs.
# Authorization URL https://health.bielefeldt.dev/oauth/authorize
# Access token URL https://health.bielefeldt.dev/oauth/token
ALEXA_SKILL_ID=
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
# Daily calorie recommendation. SEX is male or female. Set HEIGHT_IN or HEIGHT_CM. HEIGHT_IN wins if both are set.
BIRTH_YEAR=
SEX=
HEIGHT_IN=
HEIGHT_CM=
# Optional: sedentary (default), light, moderate, active, or extra.
ACTIVITY=
