USDA_API_KEY=
XAI_API_KEY=
# Reasoning effort for meal logging: none, minimal, low, medium, high, xhigh, or max. Default low.
XAI_REASONING_EFFORT=low
# Reasoning effort for the Ask page. Same allowed values. Default medium.
XAI_ASK_REASONING_EFFORT=medium
# Traces go to Alloy, which forwards them to the shared MLflow Default experiment.
# Do not point these at MLflow. A container uses host.containers.internal instead of 127.0.0.1.
OTEL_SERVICE_NAME=taco
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_always_on
# Prompt versions only. Unset skips registration and keeps the prompts in source.
# Host dev uses the shared server. The quadlet sets http://mlflow:5000 in the container.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_CACHE_USERNAME=cache
MONGO_CACHE_PASSWORD=
MONGODB_URI=mongodb://cache:PASSWORD@127.0.0.1:27017/health?authSource=health
PORT=3001
HOST=127.0.0.1
CLOUDFLARE_TUNNEL_TOKEN=
# Daily calorie recommendation. SEX is male or female. Set HEIGHT_IN or HEIGHT_CM. HEIGHT_IN wins if both are set.
BIRTH_YEAR=
SEX=
HEIGHT_IN=
HEIGHT_CM=
# Optional: sedentary (default), light, moderate, active, or extra.
ACTIVITY=
